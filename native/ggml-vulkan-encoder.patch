+
+// Isolated application-specific C ABI. No PCM preprocessing or decoder changes.
+namespace {
+thread_local std::string caps_encoder_error;
+struct caps_encoder_handle { clip_ctx * ctx; int threads; };
+}
+uint32_t caps_ggml_encoder_abi_version(void) { return 1; }
+const char * caps_ggml_encoder_last_error(void) { return caps_encoder_error.c_str(); }
+size_t caps_ggml_encoder_output_rows(size_t frames) {
+    const size_t full = frames / 100;
+    if (full > std::numeric_limits<size_t>::max() / 13) return 0;
+    return full * 13 + ((frames % 100) + 7) / 8;
+}
+void * caps_ggml_encoder_load(const char * mmproj, const char * device_name, int32_t threads, int32_t use_gpu) {
+    caps_encoder_error.clear();
+    try {
+        if (!mmproj || !mmproj[0] || threads < 1 || threads > 256) {
+            throw std::runtime_error("invalid model path or thread count");
+        }
+        // The Rust llama API registers b9090 backends before calling this API.
+        if (ggml_backend_dev_count() == 0) throw std::runtime_error("ggml backends were not registered");
+        if (use_gpu && (!device_name || !device_name[0])) device_name = "Vulkan0";
+        if (use_gpu) {
+            auto dev = ggml_backend_dev_by_name(device_name);
+            if (!dev || (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU &&
+                         ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_IGPU)) {
+                throw std::runtime_error(std::string("requested GPU device unavailable: ") + device_name);
+            }
+        }
+        clip_context_params params{};
+        params.use_gpu = use_gpu != 0;
+        params.flash_attn_type = CLIP_FLASH_ATTN_TYPE_DISABLED;
+        params.warmup = false;
+        params.caps_backend_device = device_name;
+        auto loaded = clip_init(mmproj, params);
+        if (loaded.ctx_v) clip_free(loaded.ctx_v);
+        std::unique_ptr<clip_ctx, decltype(&clip_free)> ctx(loaded.ctx_a, &clip_free);
+        if (!ctx) throw std::runtime_error("unable to load audio mmproj; see native log");
+        if (ctx->proj_type() != PROJECTOR_TYPE_QWEN3A) throw std::runtime_error("mmproj is not Qwen3A");
+        if (use_gpu && ctx->backend == ctx->backend_cpu) throw std::runtime_error("GPU device initialization fell back to CPU");
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx->ctx_data.get()); t; t = ggml_get_next_tensor(ctx->ctx_data.get(), t)) {
+            if (t->type != GGML_TYPE_F16 && t->type != GGML_TYPE_F32) {
+                throw std::runtime_error(std::string("POC requires F16/F32 weights, found ") + ggml_type_name(t->type) + " tensor " + t->name);
+            }
+        }
+        auto result = std::make_unique<caps_encoder_handle>();
+        result->ctx = ctx.release();
+        result->threads = threads;
+        LOG_INF("caps_encoder: ABI=1 b9090 qwen3a graph backport; F16 boundary; backend=%s threads=%d\n", ggml_backend_name(result->ctx->backend), threads);
+        return result.release();
+    } catch (const std::exception & e) {
+        caps_encoder_error = e.what();
+        return nullptr;
+    }
+}
+int32_t caps_ggml_encoder_dimension(void * handle) {
+    if (!handle) return 0;
+    return clip_n_mmproj_embd(static_cast<caps_encoder_handle *>(handle)->ctx);
+}
+const char * caps_ggml_encoder_backend_name(void * handle) {
+    if (!handle) return "";
+    return ggml_backend_name(static_cast<caps_encoder_handle *>(handle)->ctx->backend);
+}
+int32_t caps_ggml_encoder_stats(void * handle, uint64_t * gpu_nodes, uint64_t * cpu_nodes, uint64_t * total_nodes) {
+    if (!handle || !gpu_nodes || !cpu_nodes || !total_nodes) return -1;
+    auto ctx = static_cast<caps_encoder_handle *>(handle)->ctx;
+    *gpu_nodes = ctx->caps_gpu_nodes;
+    *cpu_nodes = ctx->caps_cpu_nodes;
+    *total_nodes = ctx->caps_total_nodes;
+    return 0;
+}
+int32_t caps_ggml_encoder_stats_detail(void * handle, uint64_t * gpu_core, uint64_t * cpu_core, uint64_t * gpu_metadata, uint64_t * cpu_metadata, uint64_t * unknown) {
+    if (!handle || !gpu_core || !cpu_core || !gpu_metadata || !cpu_metadata || !unknown) return -1;
+    auto ctx = static_cast<caps_encoder_handle *>(handle)->ctx;
+    *gpu_core = ctx->caps_gpu_core_nodes; *cpu_core = ctx->caps_cpu_core_nodes;
+    *gpu_metadata = ctx->caps_gpu_metadata_nodes; *cpu_metadata = ctx->caps_cpu_metadata_nodes;
+    *unknown = ctx->caps_unknown_nodes;
+    return 0;
+}
+int32_t caps_ggml_encoder_encode(void * handle, const float * mel, size_t frames, size_t valid_rows, float * out, size_t capacity_floats) {
+    caps_encoder_error.clear();
+    try {
+        if (!handle || !mel || !out || !frames || frames > (size_t)INT_MAX - 99) throw std::runtime_error("invalid encoder input");
+        if (valid_rows != caps_ggml_encoder_output_rows(frames)) throw std::runtime_error("valid_rows differs from existing output_length");
+        auto enc = static_cast<caps_encoder_handle *>(handle);
+        int dim = clip_n_mmproj_embd(enc->ctx);
+        if (dim <= 0 || valid_rows > std::numeric_limits<size_t>::max() / (size_t)dim || capacity_floats < valid_rows * (size_t)dim) {
+            throw std::runtime_error("output capacity too small");
+        }
+        const size_t padded = ((frames + 99) / 100) * 100;
+        if (padded > std::numeric_limits<size_t>::max() / 128 || valid_rows > (size_t)INT_MAX) throw std::runtime_error("encoder shape overflow");
+        clip_image_f32_batch batch;
+        batch.is_audio = true;
+        auto image = clip_image_f32_ptr(clip_image_f32_init());
+        image->nx = (int)padded;
+        image->ny = 128;
+        image->caps_valid_rows = (int)valid_rows;
+        image->buf.assign(128 * padded, 0.0f);
+        for (size_t band = 0; band < 128; ++band) {
+            std::copy(mel + band * frames, mel + (band + 1) * frames, image->buf.begin() + band * padded);
+        }
+        batch.entries.push_back(std::move(image));
+        if (!clip_image_batch_encode(enc->ctx, enc->threads, &batch, out)) throw std::runtime_error("ggml encoder failed; see native log");
+        return 0;
+    } catch (const std::exception & e) {
+        caps_encoder_error = e.what();
+        return -1;
+    }
+}
+void caps_ggml_encoder_free(void * handle) {
+    if (!handle) return;
+    auto enc = static_cast<caps_encoder_handle *>(handle);
+    clip_free(enc->ctx);
+    delete enc;
+}
